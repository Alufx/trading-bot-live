import os
import json
import time
import threading
import requests
import websocket
from flask import Flask
from collections import Counter, deque

BOT = os.getenv("BOT_TOKEN", "8881080452:AAH...")
CHAT = os.getenv("CHAT_ID", "79665009")
# Use your real tokens in Render -> Environment Variables

app = Flask(__name__)

@app.route('/')
def home():
    return "Bot LIVE - Real Market - Running!"

ticks = deque(maxlen=100)
digits = deque(maxlen=100)

def send_telegram(msg):
    try:
        url = f"https://api.telegram.org/bot{BOT}/sendMessage"
        requests.post(url, json={"chat_id": CHAT, "text": msg}, timeout=10)
    except Exception as e:
        print(f"Telegram error: {e}")

def on_message(ws, msg):
    try:
        data = json.loads(msg)
        if 'tick' in data:
            price = data['tick']['quote']
            ticks.append(price)
            last_digit = int(str(price)[-1])
            digits.append(last_digit)
            print(f"Price: {price} -> Digit: {last_digit}")

            if len(digits) >= 15:
                counter = Counter(digits)
                most_common = counter.most_common(1)[0]
                print(f"Stats: {counter}")

                # Example signal logic - customize yours
                if most_common[1] >= 10:
                    send_telegram(f"🔥 SIGNAL: Digit {most_common[0]} appeared {most_common[1]}/15 times! Price: {price}")
    except Exception as e:
        print(f"on_message error: {e}")

def on_error(ws, error):
    print(f"WS Error: {error}")

def on_close(ws, close_status_code, close_msg):
    print("WS Closed, reconnecting in 5s...")
    time.sleep(5)
    start_bot()

def on_open(ws):
    print("WS Connected!")
    ws.send(json.dumps({"ticks": "R_100", "subscribe": 1}))

def run_ws():
    while True:
        try:
            ws = websocket.WebSocketApp(
                "wss://ws.derivws.com/websockets/v3?app_id=1089",
                on_message=on_message,
                on_error=on_error,
                on_close=on_close,
                on_open=on_open
            )
            ws.run_forever(ping_interval=30, ping_timeout=10)
        except Exception as e:
            print(f"WS run error: {e}")
            time.sleep(5)

def start_bot():
    thread = threading.Thread(target=run_ws, daemon=True)
    thread.start()

# Start bot when gunicorn starts
start_bot()

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=int(os.getenv("PORT", 10000)))
